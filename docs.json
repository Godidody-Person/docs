{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Help Center",
  "description": "Documentation and guides for this template—workspace setup, product how-tos, and support.",
  "colors": {
    "primary": "#166E3F",
    "light": "#26BD6C",
    "dark": "#166E3F"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "directory": "card",
    "products": [
      {
        "product": "Help Center",
        "description": "Setup guides, product how-tos, automation tips, and policies.",
        "icon": "life-buoy",
        "groups": [
      {
        "group": "Getting started & account",
        "icon": "rocket",
        "expanded": true,
        "root": "getting-started/index",
        "pages": [
          {
            "group": "Billing & plans",
            "icon": "credit-card",
            "root": "getting-started/billing/index",
            "pages": [
              "getting-started/billing/upgrade-downgrade",
              "getting-started/billing/invoices-receipts"
            ]
          }
        ]
      },
      {
        "group": "Product guides",
        "icon": "book-open",
        "expanded": true,
        "root": "product/index",
        "pages": [
          "product/interface-overview",
          "product/keyboard-shortcuts",
          "product/search-navigation",
          {
            "group": "Projects",
            "icon": "folder-kanban",
            "root": "product/projects/index",
            "pages": [
              "product/projects/create-project"
            ]
          }
        ]
      }
    ]
      },
      {
        "product": "Articles",
        "description": "News, announcements, and engineering posts.",
        "icon": "newspaper",
        "href": "https://www.mintlify.com/blog"
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Get support",
        "href": "/support/contact-support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  }
}
